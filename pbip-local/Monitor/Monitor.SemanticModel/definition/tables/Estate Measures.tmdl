	measure 'Unresolved Lineage Rows' = IF ( [Unmapped Observations] = 0 && SELECTEDVALUE ( 'Estate Measures'[State] ) = "ready", CALCULATE ( [Lineage Edges Rows], 'Lineage Edges'[Resolution] <> "in_batch" ) )
