	/// Retained evidence in the selected context; not an exhaustive current-state claim.
	measure 'Metric Query Window' = IF ( [Unmapped Observations] = 0 && SELECTEDVALUE ( 'Estate Measures'[State] ) = "ready", MIN ( 'Capacity Metrics'[Metric Date] ) & " to " & MAX ( 'Capacity Metrics'[Metric Date] ) )
