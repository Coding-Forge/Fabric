	measure 'Provider Metric Peak' = IF ( [Unmapped Observations] = 0 && SELECTEDVALUE ( 'Estate Measures'[State] ) = "ready", IF ( HASONEVALUE ( 'Capacity Metrics'[Metric Name] ) && HASONEVALUE ( 'Source Folder Date'[Date] ), MAX ( 'Capacity Metrics'[Metric Value] ) ) )
