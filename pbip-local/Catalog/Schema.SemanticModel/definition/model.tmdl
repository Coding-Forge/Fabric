annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Base","Workspaces","Reports","Dashboards","Dataflows","Datamarts","Datasets","Tables","Columns","DatasetMeasures","DatasetDatasourceUsages","DatasetExpressions","DatasetRefreshSchedules","DatasetRefreshScheduleDays","DatasetRefreshScheduleTimes","DatasourceInstances","Sample File","Parameter1","Transform Sample File","Transform File","Sample File (2)","Parameter2","Transform Sample File (2)","Transform File (2)","Transform File (3)","Sample File (3)"]

annotation PBI_ProTooling = ["DevMode"]

ref table Base
