            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Failed Refreshes"
                }
              },
              "queryRef": "_Measures.Failed Refreshes",
              "nativeQueryRef": "Failed Refreshes"
            }
          ]
        }
      },
      "sortDefinition": {
