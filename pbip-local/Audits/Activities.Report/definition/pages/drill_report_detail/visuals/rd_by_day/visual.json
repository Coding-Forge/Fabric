{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.10.0/schema.json",
  "name": "rd_by_day",
  "position": { "x": 35, "y": 215, "z": 20, "height": 270, "width": 900 },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            { "field": { "Column": { "Expression": { "SourceRef": { "Entity": "activity" } }, "Property": "Event Date" } }, "queryRef": "activity.Event Date", "nativeQueryRef": "Event Date", "active": true }
          ]
        },
        "Y": {
          "projections": [
            { "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "_Measures" } }, "Property": "Total Activities" } }, "queryRef": "_Measures.Total Activities", "nativeQueryRef": "Total Activities" },
            { "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "_Measures" } }, "Property": "Failed Activities" } }, "queryRef": "_Measures.Failed Activities", "nativeQueryRef": "Failed Activities" }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          { "field": { "Column": { "Expression": { "SourceRef": { "Entity": "activity" } }, "Property": "Event Date" } }, "direction": "Ascending" }
        ]
      }
    },
    "objects": {
      "legend": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "position": { "expr": { "Literal": { "Value": "'Bottom'" } } }
          }
        }
      ],
      "dataPoint": [
        {
          "properties": { "fill": { "solid": { "color": { "expr": { "Literal": { "Value": "'#D64550'" } } } } } },
          "selector": { "metadata": "_Measures.Failed Activities" }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": "'Activity by day (total / failed)'" } } },
            "fontSize": { "expr": { "Literal": { "Value": "11D" } } }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
