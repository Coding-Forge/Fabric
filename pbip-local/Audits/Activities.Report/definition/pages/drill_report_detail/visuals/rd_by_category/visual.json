{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.10.0/schema.json",
  "name": "rd_by_category",
  "position": { "x": 950, "y": 215, "z": 21, "height": 270, "width": 440 },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            { "field": { "Column": { "Expression": { "SourceRef": { "Entity": "activity" } }, "Property": "Operation Category" } }, "queryRef": "activity.Operation Category", "nativeQueryRef": "Operation Category", "active": true }
          ]
        },
        "Y": {
          "projections": [
            { "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "_Measures" } }, "Property": "Total Activities" } }, "queryRef": "_Measures.Total Activities", "nativeQueryRef": "Total Activities" }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          { "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "_Measures" } }, "Property": "Total Activities" } }, "direction": "Descending" }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": "'Activity by operation category'" } } },
            "fontSize": { "expr": { "Literal": { "Value": "11D" } } }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
