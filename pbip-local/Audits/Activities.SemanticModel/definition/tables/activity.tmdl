	/// True for the monitor's own noise: service principal actors or Admin API operations.
	column 'Is System Activity'
		dataType: boolean
		formatString: """System activity"";""System activity"";""User activity"""
		lineageTag: 9a6b1a68-5ee1-45ca-9913-9e3ad6666408
		summarizeBy: none
		sourceColumn: Is System Activity

		annotation SummarizationSetBy = Automatic

	/// Activity when it is filled, otherwise Operation (same rule the Operation Category column uses).
	column 'Effective Activity' = IF(ISBLANK(activity[Activity]) || activity[Activity] = "", activity[Operation], activity[Activity])
		lineageTag: 3c5d7a10-8e2f-4b64-a1d9-70f2c4e9b001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// CapacityId upper-cased so it matches Capacities[Capacity Id] and CapacityMetrics[Capacity Id] (stored as upper-case GUIDs). Relationship key to Capacities.
	column 'Capacity Key' = UPPER(activity[CapacityId])
		lineageTag: 3c5d7a10-8e2f-4b64-a1d9-70f2c4e9b002
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// UTC calendar date of CreationTime (not the local Event Date). Relationship key to dimDate so activity lines up with the UTC Metric Date of CapacityMetrics.
	column 'Event Date UTC' = DATE(YEAR(activity[CreationTime]), MONTH(activity[CreationTime]), DAY(activity[CreationTime]))
		formatString: Short Date
		lineageTag: 3c5d7a10-8e2f-4b64-a1d9-70f2c4e9b003
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// UTC hour (0-23) of CreationTime; compared with the UTC hour of CapacityMetrics[Timepoint].
	column 'Event Hour UTC' = HOUR(activity[CreationTime])
		formatString: 0
		lineageTag: 3c5d7a10-8e2f-4b64-a1d9-70f2c4e9b004
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition activity = m
		mode: import
		source =
				let
				  Source = Folder.Files("C:\Projects\Tests\monitor-poc-output\activity"),
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"Content"}),
				    #"Filtered Hidden Files1" = Table.SelectRows(#"Removed Other Columns", each [Attributes]?[Hidden]? <> true),
				    #"Invoke Custom Function1" = Table.AddColumn(#"Filtered Hidden Files1", "Transform File", each #"Transform File"([Content])),
				    #"Removed Other Columns1" = Table.SelectColumns(#"Invoke Custom Function1", {"Transform File"}),
				    #"Expanded Table Column1" = Table.ExpandTableColumn(#"Removed Other Columns1", "Transform File", Table.ColumnNames(#"Transform File"(#"Sample File"))),
				    #"Changed Type" = Table.TransformColumnTypes(#"Expanded Table Column1",{{"Id", type text}, {"RecordType", Int64.Type}, {"CreationTime", type datetime}, {"Operation", type text}, {"OrganizationId", type text}, {"UserType", Int64.Type}, {"UserKey", type text}, {"Workload", type text}, {"UserId", type text}, {"ClientIP", type text}, {"Activity", type text}, {"ItemName", type text}, {"WorkSpaceName", type text}, {"DatasetName", type text}, {"CapacityId", type text}, {"CapacityName", type text}, {"WorkspaceId", type text}, {"ObjectId", type text}, {"DatasetId", type text}, {"DataConnectivityMode", type text}, {"ArtifactId", type text}, {"ArtifactName", type text}, {"IsSuccess", type logical}, {"RequestId", type text}, {"ActivityId", type text}, {"RefreshType", type text}, {"LastRefreshTime", type datetime}, {"ArtifactKind", type text}, {"RefreshEnforcementPolicy", Int64.Type}, {"ItemId", type text}, 				    {"BillingType", Int64.Type}}),
				    				    // Event Id dedupe: keep one row per Id so overlapping reruns are not double counted (rows without an Id are all kept).
				    #"Deduplicated by Id" = Table.Combine({Table.Distinct(Table.SelectRows(#"Changed Type", each [Id] <> null and [Id] <> ""), {"Id"}), Table.SelectRows(#"Changed Type", each [Id] = null or [Id] = "")}),
				    // Local time: CreationTime is UTC; shift by the fixed 'Local UTC Offset Hours' parameter (default -4, no DST handling).
				    #"Added Event Time Local" = Table.AddColumn(#"Deduplicated by Id", "Event Time Local", each [CreationTime] + #duration(0, #"Local UTC Offset Hours", 0, 0), type nullable datetime),
				    #"Added Event Date" = Table.AddColumn(#"Added Event Time Local", "Event Date", each DateTime.Date([Event Time Local]), type nullable date),
				    #"Added Hour of Day" = Table.AddColumn(#"Added Event Date", "Hour of Day", each if [Event Time Local] = null then null else Time.Hour(DateTime.Time([Event Time Local])), Int64.Type),
				    DayNames = {"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"},
				    #"Added Day of Week Sort" = Table.AddColumn(#"Added Hour of Day", "Day of Week Sort", each if [Event Date] = null then null else Date.DayOfWeek([Event Date], Day.Monday) + 1, Int64.Type),
				    #"Added Day of Week" = Table.AddColumn(#"Added Day of Week Sort", "Day of Week", each if [Day of Week Sort] = null then null else DayNames{[Day of Week Sort] - 1}, type nullable text),
				    // Classification helpers. Rules are evaluated top to bottom and the first match wins.
				    AdminApiNames = {"ExportActivityEvents", "GetCapacitiesAsAdmin", "GetModifiedWorkspacesAPI", "GetWorkspacesInfoAPI", "GetWorkspacesInfoResult", "GetWorkspacesViaAdminApi", "GetTenantSettingsViaAdminApi"},
				    ExternalAppNames = {"AnalyzedByExternalApplication", "ConnectFromExternalApplication"},
				    StartsWithAny = (t as text, p as list) as logical => List.AnyTrue(List.Transform(p, each Text.StartsWith(t, _))),
				    ContainsAny = (t as text, p as list) as logical => List.AnyTrue(List.Transform(p, each Text.Contains(t, _))),
				    EffectiveActivity = (r as record) as nullable text => if r[Activity] <> null and r[Activity] <> "" then r[Activity] else r[Operation],
				    IsAdminApi = (a as nullable text) as logical => a <> null and (List.Contains(AdminApiNames, a) or (Text.StartsWith(a, "Get") and (Text.EndsWith(a, "ViaAdminApi") or Text.EndsWith(a, "AsAdmin")))),
				    // UserType values treated as non-human: 3 (as specified), 4 (System), 5 (Application) and 6 (ServicePrincipal) - the sample refresh events carry UserType 6.
				    				    ServicePrincipalUserTypes = {3, 4, 5, 6},
				    ClassifyActor = (r as record) as text =>
				        let a = EffectiveActivity(r)
				        in if List.Contains(ServicePrincipalUserTypes, r[UserType]) or IsAdminApi(a) then "Service principal"
				           else if a <> null and List.Contains(ExternalAppNames, a) then "External app"
				           else "Human",
				    ClassifyOperation = (a as nullable text) as text =>
				        if a = null then "Other"
				        else if List.Contains(ExternalAppNames, a) then "External app"
				        else if IsAdminApi(a) or Text.StartsWith(a, "GetWorkspacesInfo") then "Admin API"
				        else if Text.Contains(a, "Refresh") then "Refresh"
				        else if StartsWithAny(a, {"View", "Read"}) then "View"
				        else if Text.StartsWith(a, "Share") or ContainsAny(a, {"Permission", "Link", "Access"}) then "Sharing"
				        else if StartsWithAny(a, {"Export", "Print", "Download"}) then "Export"
				        else if ContainsAny(a, {"Role", "Credentials", "Label"}) or (Text.Contains(a, "Tenant") and Text.Contains(a, "Settings")) then "Security"
				        else if StartsWithAny(a, {"Update", "Create", "Edit", "Delete", "Import", "Install"}) then "Edit"
				        else "Other",
				    #"Added Actor Type" = Table.AddColumn(#"Added Day of Week", "Actor Type", each ClassifyActor(_), type text),
				    #"Added Actor Type Sort" = Table.AddColumn(#"Added Actor Type", "Actor Type Sort", each if [Actor Type] = "Human" then 1 else if [Actor Type] = "Service principal" then 2 else 3, Int64.Type),
				    #"Added Operation Category" = Table.AddColumn(#"Added Actor Type Sort", "Operation Category", each ClassifyOperation(EffectiveActivity(_)), type text),
				    #"Added Is System Activity" = Table.AddColumn(#"Added Operation Category", "Is System Activity", each [Actor Type] = "Service principal" or [Operation Category] = "Admin API", type logical)
				in
				  #"Added Is System Activity"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

