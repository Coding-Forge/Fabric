	annotation PBI_ResultType = Function

expression 'Latest Catalog Scan' =
		let
		    Root = "C:\Projects\Tests\monitor\catalog\scans",
		    Source = try Folder.Files(Root) otherwise #table(type table [Content = binary, Name = text, Extension = text, Date accessed = nullable datetime, Date modified = nullable datetime, Date created = nullable datetime, Attributes = record, Folder Path = text], {}),
		    Files = Table.SelectRows(Source, each Text.EndsWith([Name], ".scanResults.json") and [Attributes]?[Hidden]? <> true),
		    Latest = if Table.RowCount(Files) = 0 then null else Binary.Buffer(Table.Sort(Files, {{"Date modified", Order.Descending}}){0}[Content]),
		    Json = if Latest = null then null else Json.Document(Latest)
		in
		    Json
	lineageTag: 7a239dc4-1320-4a0c-864d-0889b7f65020

	annotation PBI_ResultType = Record

