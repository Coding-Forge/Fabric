                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Slicers filter retained job facts only. Unfiltered coverage shows latest finished-poll outcomes, including empty/failed targets; incomplete evidence may omit unvisited targets. Raw failure payloads excluded.",
