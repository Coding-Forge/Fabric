                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Check collection status first. Not collected means disabled, unconfigured or never run; blank counts are not healthy zeroes. This read-only report neither enables collection nor selects targets.",
