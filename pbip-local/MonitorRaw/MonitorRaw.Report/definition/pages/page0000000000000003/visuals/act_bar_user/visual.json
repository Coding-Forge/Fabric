{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "act_bar_user",
  "position": {
    "x": 650,
    "y": 450,
    "width": 610,
    "height": 250,
    "z": 6000,
    "tabOrder": 6000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Activity"
                    }
                  },
                  "Property": "User Id"
                }
              },
              "queryRef": "Activity.User Id",
              "nativeQueryRef": "User Id",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Activity"
                    }
                  },
                  "Property": "Activity Count"
                }
              },
              "queryRef": "Activity.Activity Count",
              "nativeQueryRef": "Activity Count"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Activity"
                  }
                },
                "Property": "Activity Count"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Top users'"
                }
              }
            }
          }
        }
      ]
    }
  }
}