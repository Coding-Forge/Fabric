{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "lnk_bar_artifact",
  "position": {
    "x": 20,
    "y": 210,
    "width": 500,
    "height": 490,
    "z": 5000,
    "tabOrder": 5000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Widely Shared Links"
                    }
                  },
                  "Property": "Artifact Type"
                }
              },
              "queryRef": "Widely Shared Links.Artifact Type",
              "nativeQueryRef": "Artifact Type",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Widely Shared Links"
                    }
                  },
                  "Property": "Shared Link Count"
                }
              },
              "queryRef": "Widely Shared Links.Shared Link Count",
              "nativeQueryRef": "Shared Link Count"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Shared links by artifact type (latest snapshot)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}