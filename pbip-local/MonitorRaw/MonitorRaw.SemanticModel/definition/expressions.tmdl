/// Stable list normalization preserves one row per principal/access detail, rather than multiplying grants by permission strings.
expression NormalizeFabricPermissions = (values as list) as text => Text.Combine(List.Sort(List.Distinct(values)), ", ")
	lineageTag: 032ac636-c9a2-4fa7-8c8c-6edbd66b1ca3

