/// Calendar covering the dates found in Capacity Metrics and Activity, plus today.
table Calendar
	lineageTag: ec45bfe4-cc18-484c-b5f3-f4eac56503b2
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: 3ca30589-7849-4ea4-ab64-75ac85db32dd
		summarizeBy: none
		sourceColumn: [Date]

	column Year = YEAR('Calendar'[Date])
		dataType: int64
		formatString: 0
		lineageTag: 1235a819-d0e5-42d4-89dd-17fda87a16f3
		summarizeBy: none

	column 'Month Number' = MONTH('Calendar'[Date])
		dataType: int64
		formatString: 0
		lineageTag: b2683476-3ec0-446b-9348-4e8caab0e831
		summarizeBy: none

	column 'Month Name' = FORMAT('Calendar'[Date], "MMM")
		dataType: string
		lineageTag: 2ca89e3f-4658-4c89-a768-054b8bc951fb
		summarizeBy: none
		sortByColumn: 'Month Number'

	column Year-Month = FORMAT('Calendar'[Date], "yyyy-MM")
		dataType: string
		lineageTag: 5528f9ef-4753-4ac5-89f8-5d7a2d2949d9
		summarizeBy: none

	partition Calendar = calculated
		mode: import
		source =
				VAR _Dates =
					UNION(
						ROW("d", MIN('Capacity Metrics'[Metric Date])),
						ROW("d", MAX('Capacity Metrics'[Metric Date])),
						ROW("d", MIN('Activity'[Event Date])),
						ROW("d", MAX('Activity'[Event Date])),
						ROW("d", TODAY())
					)
				RETURN
					CALENDAR(MINX(_Dates, [d]), MAXX(_Dates, [d]))

	annotation PBI_ResultType = Table

