/// One diagnostic row per supported Fabric collector, including not-collected and successful-empty states. Disconnected from inventory/history so slicers cannot hide collection health.
table 'Collection Status'
	lineageTag: f4a4127d-4e64-487c-b731-c5bcfe02897b

	measure 'Connections Collection Status' =
			VAR _State = CALCULATE(SELECTEDVALUE('Collection Status'[State]), 'Collection Status'[Module] = "fabricconnections")
			VAR _Snapshot = CALCULATE(MAX('Collection Status'[Snapshot UTC]), 'Collection Status'[Module] = "fabricconnections")
			RETURN _State & IF(NOT ISBLANK(_Snapshot), " | Snapshot UTC: " & FORMAT(_Snapshot, "yyyy-MM-dd HH:mm:ss"))
		displayFolder: Data health
		lineageTag: 5a00647f-855b-499c-8626-ab39cbb760c9

	measure 'Deployment Collection Status' =
			VAR _State = CALCULATE(SELECTEDVALUE('Collection Status'[State]), 'Collection Status'[Module] = "fabricdeploymentpipelineoperations")
			VAR _Snapshot = CALCULATE(MAX('Collection Status'[Snapshot UTC]), 'Collection Status'[Module] = "fabricdeploymentpipelineoperations")
			RETURN _State & IF(NOT ISBLANK(_Snapshot), " | Discovery UTC: " & FORMAT(_Snapshot, "yyyy-MM-dd HH:mm:ss"))
		displayFolder: Data health
		lineageTag: c669c81a-f87c-4341-b189-e2b1b3001aa1

	measure 'Fabric Collection Load Errors' = COALESCE(CALCULATE(SUM('Collection Status'[Error Count]), REMOVEFILTERS('Collection Status')), 0)
		formatString: #,0
		displayFolder: Data health
		lineageTag: 7cc61b80-147b-4866-bc5c-b07ebbe233fb

	measure 'Item Permissions Collection Status' =
			VAR _State = CALCULATE(SELECTEDVALUE('Collection Status'[State]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
			VAR _Snapshot = CALCULATE(MAX('Collection Status'[Snapshot UTC]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
			VAR _Attempt = CALCULATE(MAX('Collection Status'[Last Attempt UTC]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
			VAR _LatestCycle = CALCULATE(SELECTEDVALUE('Collection Status'[Permission Latest Cycle Id]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
			VAR _Start = CALCULATE(MAX('Collection Status'[Permission Observation Start UTC]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
			VAR _End = CALCULATE(MAX('Collection Status'[Permission Observation End UTC]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
			RETURN _State
				& IF(NOT ISBLANK(_Snapshot), " | Selected evidence UTC: " & FORMAT(_Snapshot, "yyyy-MM-dd HH:mm:ss"))
				& IF(NOT ISBLANK(_Start), " | Observations UTC: " & FORMAT(_Start, "yyyy-MM-dd HH:mm:ss") & " to " & FORMAT(_End, "yyyy-MM-dd HH:mm:ss"))
				& IF(NOT ISBLANK(_Attempt), " | Latest attempt UTC: " & FORMAT(_Attempt, "yyyy-MM-dd HH:mm:ss"))
				& IF(NOT ISBLANK(_LatestCycle), " | Latest cycle: " & _LatestCycle)
		displayFolder: Data health
		lineageTag: ba434cb0-248a-4e18-97be-ab29a52a4a9a

	measure 'Fabric Jobs Collection Status' =
			VAR _State = CALCULATE(SELECTEDVALUE('Collection Status'[State]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemjobhistory")
			VAR _Snapshot = CALCULATE(MAX('Collection Status'[Snapshot UTC]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemjobhistory")
			RETURN _State & IF(NOT ISBLANK(_Snapshot), " | Complete poll UTC: " & FORMAT(_Snapshot, "yyyy-MM-dd HH:mm:ss"))
		displayFolder: Data health
		lineageTag: 37702779-0462-4a53-ab85-8286137d58ea

	measure 'Permission Successful Target Count' = CALCULATE(MAX('Collection Status'[Permission Successful Targets]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
		formatString: #,0
		displayFolder: Permission coverage
		lineageTag: 38e91b3b-8c5e-4616-a76d-e65506edf785

	measure 'Permission Expected Target Count' = CALCULATE(MAX('Collection Status'[Permission Expected Targets]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
		formatString: #,0
		displayFolder: Permission coverage
		lineageTag: 08ad256f-edbd-4416-8aa3-438af1a02863

	measure 'Permission Failed Target Count' = CALCULATE(MAX('Collection Status'[Permission Failed Targets]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
		formatString: #,0
		displayFolder: Permission coverage
		lineageTag: 2275b89f-8c61-4c81-8771-06b7d4168a94

	measure 'Permission Deferred Target Count' = CALCULATE(MAX('Collection Status'[Permission Deferred Targets]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
		formatString: #,0
		displayFolder: Permission coverage
		lineageTag: ef9835a1-27f5-4a97-908b-418da2518f06

	measure 'Permission Not Attempted Target Count' = CALCULATE(MAX('Collection Status'[Permission Not Attempted Targets]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
		formatString: #,0
		displayFolder: Permission coverage
		lineageTag: 8060d152-bca3-493f-8a96-0e57df1e363e

	measure 'Permission Target Read Rate' = DIVIDE([Permission Successful Target Count], [Permission Expected Target Count])
		formatString: 0.0%
		displayFolder: Permission coverage
		lineageTag: 241b2e6f-a92e-4a2a-bd6b-af4d9921095e

	measure 'Permission Coverage Is Partial' = CALCULATE(SELECTEDVALUE('Collection Status'[Permission Partial Coverage]), REMOVEFILTERS('Collection Status'), 'Collection Status'[Module] = "fabricitemaccesspermissions")
		displayFolder: Permission coverage
		lineageTag: f2b22878-12b9-4396-a32b-d617b1e358fc

	measure 'Permission Coverage Warning' = IF([Permission Coverage Is Partial], [Item Permissions Collection Status])
		displayFolder: Permission coverage
		lineageTag: 66d9f7bf-0bb7-4856-a733-f172ea3e7ae5

	column Module
