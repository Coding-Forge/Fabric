	partition 'Collection Status' = m
		mode: import
		source =
				Table.FromRecords(
					{FabricConnectionsData[Status], FabricDeploymentData[Status], FabricItemPermissionsData[Status], FabricItemJobsData[Status]},
					type table [
						Module = nullable text, State = nullable text, #"Last Attempt UTC" = nullable datetime,
						#"Snapshot UTC" = nullable datetime, #"Snapshot Row Count" = nullable number,
						#"Has Snapshot" = nullable logical, #"Latest Run Complete" = nullable logical,
						#"Error Count" = nullable number, #"Load Error" = nullable text, Coverage = nullable text,
						#"Permission Cycle Id" = nullable text, #"Permission Latest Cycle Id" = nullable text,
						#"Permission Cycle Status" = nullable text, #"Permission Latest Attempt Status" = nullable text,
						#"Permission Successful Targets" = nullable number, #"Permission Failed Targets" = nullable number,
						#"Permission Deferred Targets" = nullable number, #"Permission Not Attempted Targets" = nullable number,
						#"Permission Expected Targets" = nullable number, #"Permission Unknown Targets" = nullable number,
						#"Permission Remaining Tasks" = nullable number, #"Permission Partial Coverage" = nullable logical,
						#"Permission Observation Start UTC" = nullable datetime, #"Permission Observation End UTC" = nullable datetime
					], MissingField.UseNull
				)

	annotation PBI_ResultType = Table

