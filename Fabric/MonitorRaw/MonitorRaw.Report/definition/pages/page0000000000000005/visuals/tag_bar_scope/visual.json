{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "tag_bar_scope",
  "position": { "x": 20, "y": 210, "width": 500, "height": 490, "z": 2000, "tabOrder": 2000 },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            { "field": { "Column": { "Expression": { "SourceRef": { "Entity": "Tags" } }, "Property": "Scope Type" } }, "queryRef": "Tags.Scope Type", "nativeQueryRef": "Scope Type", "active": true }
          ]
        },
        "Y": {
          "projections": [
            { "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "Tags" } }, "Property": "Tag Count" } }, "queryRef": "Tags.Tag Count", "nativeQueryRef": "Tag Count" }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
    "title": [
      { "properties": { "show": { "expr": { "Literal": { "Value": "true" } } }, "text": { "expr": { "Literal": { "Value": "'Tags by scope (latest snapshot)'" } } } } }
    ]
    }
  }
}
