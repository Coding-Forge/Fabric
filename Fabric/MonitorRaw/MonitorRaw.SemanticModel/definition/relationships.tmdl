relationship rel_CapacityMetrics_Capacities
	fromColumn: 'Capacity Metrics'.'Capacity Id'
	toColumn: Capacities.'Capacity Id'

relationship rel_CapacityMetrics_Calendar
	fromColumn: 'Capacity Metrics'.'Metric Date'
	toColumn: Calendar.Date

relationship rel_Activity_Calendar
	fromColumn: Activity.'Event Date'
	toColumn: Calendar.Date
