/// Latest snapshot of workspace Git connections (gitconnections/YYYY/MM/DD/gitconnections.json); older days are not summed.
table 'Git Connections'

	measure 'Git Connection Count' = CALCULATE(COUNTROWS('Git Connections'), 'Git Connections'[Load Error] = BLANK())
		formatString: #,0
		displayFolder: Counts

	measure 'Git Workspace Count' = CALCULATE(DISTINCTCOUNT('Git Connections'[Workspace Id]), 'Git Connections'[Load Error] = BLANK())
		formatString: #,0
		displayFolder: Counts

	measure 'Git Repository Count' = CALCULATE(DISTINCTCOUNT('Git Connections'[Repository Name]), 'Git Connections'[Load Error] = BLANK())
		formatString: #,0
		displayFolder: Counts

	column 'Workspace Id'
		dataType: string
		summarizeBy: none
		sourceColumn: Workspace Id

	column 'Git Provider Type'
		dataType: string
		summarizeBy: none
		sourceColumn: Git Provider Type

	column 'Owner Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Owner Name

	column 'Organization Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Organization Name

	column 'Project Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Project Name

	column 'Repository Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Repository Name

	column 'Branch Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Branch Name

	column 'Directory Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Directory Name

	column 'Connection State'
		dataType: string
		summarizeBy: none
		sourceColumn: Connection State

	column 'Last Sync Time'
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: Last Sync Time

	column 'Snapshot Date'
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: Snapshot Date

	column 'Source File'
		dataType: string
		summarizeBy: none
		sourceColumn: Source File

	column 'Load Error'
		dataType: string
		summarizeBy: none
		sourceColumn: Load Error

	partition 'Git Connections' = m
		mode: import
		source =
				let
					Items = ExpandItems(KeepLatestPerGroup(GetFiles("gitconnections"), "Group")),
					WithColumns = AddColumns(Items, {
						{"Workspace Id", each ToText(JsonField([Item], "workspaceId")), type text},
						{"Git Provider Type", each ToText(JsonField(JsonField([Item], "gitProviderDetails"), "gitProviderType")), type text},
						{"Owner Name", each ToText(JsonField(JsonField([Item], "gitProviderDetails"), "ownerName")), type text},
						{"Organization Name", each ToText(JsonField(JsonField([Item], "gitProviderDetails"), "organizationName")), type text},
						{"Project Name", each ToText(JsonField(JsonField([Item], "gitProviderDetails"), "projectName")), type text},
						{"Repository Name", each ToText(JsonField(JsonField([Item], "gitProviderDetails"), "repositoryName")), type text},
						{"Branch Name", each ToText(JsonField(JsonField([Item], "gitProviderDetails"), "branchName")), type text},
						{"Directory Name", each ToText(JsonField(JsonField([Item], "gitProviderDetails"), "directoryName")), type text},
						{"Connection State", each ToText(JsonField([Item], "gitConnectionState")), type text},
						{"Last Sync Time", each ToUtcDateTime(JsonField(JsonField([Item], "gitSyncDetails"), "lastSyncTime")), type nullable datetime},
						{"Snapshot Date", each [FileDate], type nullable date},
						{"Source File", each if [ParseError] <> null then [RelPath] else null, type text},
						{"Load Error", each [ParseError], type text}
					}),
					Result = Table.SelectColumns(WithColumns, {"Workspace Id", "Git Provider Type", "Owner Name", "Organization Name", "Project Name", "Repository Name", "Branch Name", "Directory Name", "Connection State", "Last Sync Time", "Snapshot Date", "Source File", "Load Error"})
				in
					Result

	annotation PBI_ResultType = Table
