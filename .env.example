TENANT_ID=""
CLIENT_ID=""
CLIENT_SECRET=""
CLOUD_ENVIRONMENT="Commercial"
# Commercial, Gcc, GccHigh, Dod. Fabric REST and OneLake require Commercial.
APPLICATION_MODULES="Activity,Apps,Catalog,Graph,Tenant,RefreshHistory,Gateway"

# Optional standalone output; defaults to Data only when no storage is configured.
OUTPUT_PATH=""
# Explicit PoC mode overrides all Blob/Lakehouse output settings.
LOCAL_OUTPUT_PATH=""
STORAGE_ACCOUNT_NAME=""
STORAGE_ACCOUNT_CONNECTION_STRING=""
STORAGE_ACCOUNT_URL=""
STORAGE_ACCOUNT_CONTAINER_NAME=""
STORAGE_ACCOUNT_CONTAINER_ROOT_PATH=""
ON_FABRIC="true"
LAKEHOUSE_NAME=""
WORKSPACE_NAME=""
PATH_IN_LAKEHOUSE=""
ALL_WORKSPACES="false"
EXCLUDE_PERSONAL_WORKSPACES="true"
EXCLUDE_INACTIVE_WORKSPACES="true"
GRAPH_EXTRACT_GROUPS="false"
# Optional audience group IDs override the PowerBI / Power BI prefix matching.
POWER_BI_AUDIENCE_GROUP_IDS=""
# No additional Scanner calls; include Catalog in APPLICATION_MODULES.
CATALOG_LINEAGE_ENABLED="false"

# Optional per-module cron overrides
FABRICITEMS_CRON=""
WORKSPACES_CRON=""
CAPACITYMETRICS_CRON=""
# Optional modules (add to APPLICATION_MODULES to enable): GitConnections (preview API),
# Tags, DelegatedSettings, WidelySharedLinks
GITCONNECTIONS_CRON=""
TAGS_CRON=""
DELEGATEDSETTINGS_CRON=""
WIDELYSHAREDLINKS_CRON=""
FABRICITEMACCESSPERMISSIONS_CRON=""
FABRICITEMJOBHISTORY_CRON=""
FABRICITEMDEFINITIONS_CRON=""
FABRICCONNECTIONS_CRON=""
